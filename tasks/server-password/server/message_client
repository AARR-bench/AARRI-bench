def list_members():
    print(f"Lab Members ({len(MEMBERS)} total):")
    for m in MEMBERS:
        online = "[ONLINE]" if m["status"] == "online" else "[OFFLINE]"
        print(f"  {m['name']} ({m['role']}) {online}")


def show_profile(name):
    name_lower = name.lower()
    for m in MEMBERS:
        if m["name"].lower() == name_lower:
            status = "ONLINE" if m["status"] == "online" else "OFFLINE"
            print(f"Name: {m['name']}")
            print(f"Role: {m['role']}")
            print(f"Status: {status}")
            return
    print(f"Member '{name}' not found.")


def send_message(name, message):
